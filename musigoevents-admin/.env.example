# Shared password to log into the admin page. Set a real value in Vercel's
# environment variables (or your host's equivalent) — do not commit a real
# password to git.
ADMIN_PASSWORD=change-me

# A long random string used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-too

# The Google Sheet the waitlist form writes to.
# From a URL like:
#   https://docs.google.com/spreadsheets/d/1A4uUkDy3w52VF8ydtb8sgJph7Tsg1nWsejIaJ4meWXU/edit?gid=632397940
# SHEET_ID is the long id between /d/ and /edit, SHEET_GID is the gid= value.
SHEET_ID=1A4uUkDy3w52VF8ydtb8sgJph7Tsg1nWsejIaJ4meWXU
SHEET_GID=632397940
