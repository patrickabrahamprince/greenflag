<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- Only standard HTTPS/TLS is used (Supabase, Vercel, Apple's own
	     APIs) -- no custom or proprietary encryption. Without this key,
	     App Store Connect can't auto-determine the answer and flags every
	     single upload as "Missing Compliance" until it's answered
	     manually in the portal for that specific build. Setting it here
	     makes every future build declare itself automatically. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>GreenFlag</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>11</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Scoped to localhost only, for local dev against a plain-HTTP dev
	     server (server.url's cleartext:true in capacitor.config.ts only
	     covers Android; iOS needs this ATS exception separately). The
	     shipped App Store build points at the real HTTPS production URL
	     and never touches this exception. A blanket
	     NSAllowsArbitraryLoads would both weaken security for no reason
	     and draw extra App Review scrutiny. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Task submissions capture a photo or voice note (photo: file input
	     with capture="environment" in PhotoUploadSlots.tsx; voice:
	     getUserMedia({ audio: true }) in SubmitSheet.tsx) -- iOS shows
	     these system prompts even from inside a WKWebView, and silently
	     denies access (rather than prompting) if the matching usage
	     string is missing. -->
	<key>NSCameraUsageDescription</key>
	<string>GreenFlag needs camera access so you can capture photos for your profile and daily intentions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GreenFlag needs microphone access to record your voice intentions as part of your daily tasks.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GreenFlag needs photo library access so you can choose photos for your profile and submissions.</string>
	<!-- app/(auth)/onboard/profile/page.tsx calls navigator.geolocation to
	     auto-detect city during onboarding -- without this key iOS denies
	     the request outright (no prompt), so detection silently never
	     resolves and the field just sits on "Detecting location...". -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GreenFlag uses your location to suggest your city during profile setup.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>GreenFlag uses your location to find nearby matches and suggest your city during profile setup.</string>
	<!-- AppLockGate (components/security/AppLockGate.tsx) calls
	     LocalAuthentication via @aparajita/capacitor-biometric-auth to lock
	     the app behind Face ID on launch/resume -- iOS crashes outright if
	     this key is missing when the Face ID prompt is invoked. -->
	<key>NSFaceIDUsageDescription</key>
	<string>GreenFlag uses Face ID to keep your matches and messages private if someone else picks up your phone.</string>
	<!-- Native Google Sign-In (lib/native/socialLogin.ts via
	     @capgo/capacitor-social-login). GIDClientID is the iOS OAuth
	     client id from Google Cloud Console (project "Viveapp"); the URL
	     scheme is that same id's components reversed, per Google's own
	     convention, so Google's SDK can hand control back to this app
	     after the native sign-in sheet closes. -->
	<key>GIDClientID</key>
	<string>953419391945-edi4itkvgt4t7qtprsil9d7mnm9ih2bc.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.953419391945-edi4itkvgt4t7qtprsil9d7mnm9ih2bc</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
