NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_RAZORPAY_KEY=rzp_live_xxxxx
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-random-secret-and-set-in-vercel
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Google OAuth (enable in Supabase Dashboard → Auth → Providers → Google)
# Get these from Google Cloud Console → APIs & Services → Credentials
# Add redirect URI: https://[your-project-ref].supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

